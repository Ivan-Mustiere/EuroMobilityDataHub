# Copier ce fichier en .env (non versionné) et l'adapter localement si besoin.

# Environnement utilisé par défaut quand --env n'est pas passé en ligne de commande
# (dev | preprod | prod). La configuration détaillée par environnement (chemin de la
# base DuckDB, taille d'échantillon, niveau de log) reste dans config/<env>.yaml.
APP_ENV=dev

# UID/GID de l'utilisateur hôte, utilisés par docker-compose pour que les fichiers écrits
# dans les volumes (environments/, data/, outputs/...) t'appartiennent au lieu d'appartenir
# à root. Valeurs à obtenir avec `id -u` et `id -g`.
HOST_UID=1000
HOST_GID=1000
