# Copier ce fichier en .env (non versionné) et l'adapter localement si besoin.

# Environnement utilisé par défaut quand --env n'est pas passé en ligne de commande
# (preprod | prod). La configuration détaillée par environnement (chemin de la
# base DuckDB, taille d'échantillon, niveau de log) reste dans config/<env>.yaml.
APP_ENV=preprod

# UID/GID de l'utilisateur hôte, utilisés par docker-compose pour que les fichiers écrits
# dans les volumes (environments/, data/, outputs/...) t'appartiennent au lieu d'appartenir
# à root. Valeurs à obtenir avec `id -u` et `id -g`.
HOST_UID=1000
HOST_GID=1000

# Clé(s) API acceptées par l'API (en-tête X-API-Key), séparées par des virgules — rôle
# api_consumer (Bloc 1, Tableau 13). Aucune clé configurée = aucun accès aux endpoints de
# données (échec fermé). Générer une vraie clé en local : `openssl rand -hex 32`.
API_KEYS=dev-local-key

# Clé Trafiklab "GTFS Sweden 3 Static data" (https://www.trafiklab.se), lue par
# apps/pipeline/ingest.py pour le référentiel suédois (build_se_reference) — seule source du
# pipeline batch à exiger une clé. Nécessaire uniquement pour lancer `python apps/pipeline/run.py`
# en local hors docker ; dans le conteneur `airflow`, elle vient de
# infra/cloud/local-test/se_static.env (cf. docker-compose.yml).
SE_GTFS_STATIC_KEY=
