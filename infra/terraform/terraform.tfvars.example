# Copier en terraform.tfvars (gitignored) et adapter.

aws_region          = "eu-west-3"
project_name        = "euromobilitydatahub"
my_ip_cidr          = "203.0.113.42/32" # `curl -s https://checkip.amazonaws.com` puis ajouter /32
budget_alert_email  = "toi@example.com"
budget_limit_usd    = 20
ec2_instance_type   = "t3.medium"
rds_instance_class  = "db.t3.micro"
snowflake_warehouse_size = "XSMALL"

# Snowflake : credentials NON stockées ici (voir providers.tf) — à exporter dans le shell avant
# `terraform apply` :
#   export SNOWFLAKE_ORGANIZATION_NAME="..."
#   export SNOWFLAKE_ACCOUNT_NAME="..."
#   export SNOWFLAKE_USER="..."
#   export SNOWFLAKE_AUTHENTICATOR="SNOWFLAKE_JWT"
#   export SNOWFLAKE_PRIVATE_KEY="$(cat ~/.ssh/snowflake_key.p8)"
#   export SNOWFLAKE_ROLE="ACCOUNTADMIN"   # doit pouvoir CREATE DATABASE/WAREHOUSE/INTEGRATION
