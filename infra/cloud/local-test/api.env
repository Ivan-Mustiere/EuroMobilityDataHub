# Valeurs factices pour tester la stack en local (docker compose up) sans secret réel.
API_KEYS=dev-local-key
# Clé gratuite CARTO (https://carto.com/basemaps/apikey) pour les tuiles de fond de carte de
# /realtime/map — à remplacer par ta vraie clé, sinon la carte affiche le watermark "API KEY REQUIRED".
CARTO_API_KEY=REMPLACE_MOI
# Clé API SNCF officielle (https://numerique.sncf.com/startup/api/) pour la cause des retards
# (`cause_retard` sur /realtime/trains) — optionnelle : sans clé, le champ reste à null.
SNCF_API_KEY=REMPLACE_MOI
