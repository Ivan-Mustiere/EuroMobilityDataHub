# Valeurs factices pour démarrer Airflow en local sans écraser de vrai secret — le DAG batch
# échouera si déclenché (normal, pas de vrai compte Snowflake ici), mais Airflow démarre.
SNOWFLAKE_ORGANIZATION_NAME=local-test
SNOWFLAKE_ACCOUNT_NAME=local-test
SNOWFLAKE_USER=local-test
SNOWFLAKE_ROLE=ETL_LOADER
SNOWFLAKE_WAREHOUSE=local-test
SNOWFLAKE_DATABASE=local-test
SNOWFLAKE_PRIVATE_KEY=local-test
BRONZE_BUCKET=local-test
