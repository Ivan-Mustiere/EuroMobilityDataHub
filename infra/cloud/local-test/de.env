# Flux GTFS-RT allemand agrégat national (DELFI/gtfs.de) pour producer_de/consumer_de. Public,
# sans authentification : rien à remplacer ici. Filtré sur les trains via RAIL_TRIPS_FILE (le flux
# ne publie jamais de route_id, contrairement à la Suisse — cf. apps/streaming/producer.py).
FEED_URL=https://realtime.gtfs.de/realtime-free.pb
PAYS=DE
TOPIC=gtfs-rt-trip-updates-de
RAIL_TRIPS_FILE=/app/data/raw/de_rail_trips.txt
