.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Document de pilotage local, ne doit pas être publié
claude.md

# Données brutes/traitées régénérables via pipeline/ingest.py et transform.py
data/raw/
data/processed/
environments/*/*.duckdb

# Sorties intermédiaires (preprod/dev) régénérables — seul l'instantané horodaté officiel
# généré depuis prod (outputs/prod_YYYY-MM-DD/) est versionné, pour tracer ce qui a servi
# de base au dossier déposé (cf. section Environnements du document de pilotage local)
outputs/*
!outputs/prod_*/
